# arduino-cli / build output
/build/
*.hex
*.elf
*.map

# Pinned astcenc binary fetched by tools/get-astcenc.sh
/tools/.astcenc/

# EasyEDA Pro hourly autosaves (the .eprj2 project itself IS tracked)
/EasyEDA/*_backup/

# PlatformIO build output and per-machine IDE config.
# .vscode/extensions.json IS tracked; the rest embed absolute paths.
.pio/
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/.browse.c_cpp.db*
.vscode/ipch/

# Scratch log dropped in the repo root by tooling; never a build input.
/debug.log

# KiCad per-user churn. The board and schematic files under kicad/ ARE tracked --
# git diff is how the evaluation verifies that a write landed, so the design
# itself must be in the repo. These four are per-machine or regenerable and would
# otherwise produce diff noise on every open.
/kicad/**/*-backups/
*.kicad_prl
fp-info-cache
_autosave-*

# Import staging. Only the export that actually produced the tracked board is
# kept -- it is the provenance of everything downstream, so the conversion stays
# reproducible from the repo alone. Extracted trees and rejected-format exports
# are regenerable and stay out.
/kicad/_import/*
!/kicad/_import/PADS_*.zip

# kicad-happy drops an analysis cache in whatever directory it runs from.
# Regenerable per run; the committed evidence is the report tools/kicad_review.py
# writes, not this.
/analysis/
