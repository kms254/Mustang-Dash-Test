	(model "${KIPRJMOD}/EASYEDA_MODELS/USB-C_SMD-TYPE-C-31-M-12_1.step"
		(offset
			(xyz 0 -1.1 -0.85)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz -0 -0 -180)
		)
	)
)
