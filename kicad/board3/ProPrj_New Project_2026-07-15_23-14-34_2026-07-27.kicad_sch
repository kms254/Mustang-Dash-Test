	)
	(text "U10: telltale driver. H1 outputs sink to GND when ON; wire external LED anode->series resistor->+5V(H1.9), cathode->H1.1-8. Resistor/LED sized off-board per lamp color."
		(exclude_from_sim no)
		(at 173.99 284.48 0)
		(effects
			(font
				(size 0.9398 0.9398)
			)
			(justify left bottom)
		)
		(uuid "1bf62c7a-7844-4fcd-886c-277a076d3c4e")
	)
	(text "CN3: RIGHT panel (RVT50H 800x480) - RiBus 20P FPC"
		(exclude_from_sim no)
		(at 326.39 284.48 0)
		(effects
